# Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_NAME=swaya_dev
DB_USER=root
DB_PASSWORD=localpass
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_RECYCLE=3600

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_POOL_SIZE=10

# JWT Configuration
JWT_SECRET=dev_secret_key_change_in_production
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24

# Application Configuration
HOST=0.0.0.0
PORT=8000
DEBUG=true
RELOAD=true
LOG_LEVEL=DEBUG
ENVIRONMENT=development
LOGIN_RATE_LIMIT=5/minute

# CORS Configuration
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Email Configuration (any SMTP provider — Titan, Gmail, SendGrid, etc.)
SMTP_HOST=smtp.example.com
SMTP_PORT=465
IMAP_HOST=imap.example.com
IMAP_PORT=993
SMTP_USER=noreply@yourdomain.com
SMTP_PASSWORD=your_smtp_password
SMTP_FROM_EMAIL=noreply@yourdomain.com
SMTP_FROM_NAME="Swaya"
FRONTEND_URL=http://localhost:5173

# Google OAuth (optional — enables "Sign in with Google")
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# AI — provider routing (see docs/self-hosting/ai.md for the full matrix)
# AI_PRIMARY_PROVIDER handles question generation + exam analysis: gemini | openai_compat | anthropic
# AI_LIGHT_PROVIDER handles distractors/rewriting/grading: ollama (default) | gemini | openai_compat | anthropic
# Leave both unset (and all keys below empty) to run with AI features disabled.
AI_PRIMARY_PROVIDER=gemini
AI_LIGHT_PROVIDER=ollama

# AI — Google Gemini (default primary provider)
# Get a free key at https://aistudio.google.com/app/apikey
GEMINI_KEY=your_gemini_api_key
GEMINI_MODEL_COMPLEX=gemini-2.0-flash
GEMINI_MODEL_FAST=gemini-2.0-flash
GEMINI_TIMEOUT_SECONDS=60

# AI — Ollama (default light provider — local, free, no API key)
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:3b
OLLAMA_FALLBACK_MODEL=llama3.2:1b

# AI — OpenAI-compatible (optional — also used for OpenAI, Groq, Azure, Together, LM Studio, vLLM)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
OPENAI_MODEL_FAST=gpt-4o-mini
OPENAI_TIMEOUT_SECONDS=120

# AI — Anthropic Claude (optional)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
ANTHROPIC_MODEL_FAST=claude-haiku-4-5-20251001
ANTHROPIC_TIMEOUT_SECONDS=120

# Coder sandbox integration (optional — only needed for the coding_challenge quiz
# type; see docs/self-hosting/coding-challenge-vms.md)
CODER_URL=https://sandbox.example.com
CODER_CLI_PATH=coder
CODER_SERVICE_ACCOUNT_USERNAME=swaya-backend-svc
CODE_SERVER_TEMPLATE_NAME=code-server-multi
MAX_CONCURRENT_WORKSPACES=5
CODER_MAX_PARALLEL_PROVISIONS=2
# 604800 = 7 days, raised 2026-08-09 for hackathon-style multi-day coding
# challenges (see SetupPanel.jsx's Days/Hours/Minutes time limit picker)
WORKSPACE_MAX_LIFETIME_SECONDS=604800

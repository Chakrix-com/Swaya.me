# react-wordcloud@1.2.7 (used in AudienceSession/QuizControl/QuizPresent for the
# word-cloud question type) declares a peer of react@^16.13.0 and is unmaintained,
# but works fine with React 18 in practice — this app already runs on React 18
# with it in production. legacy-peer-deps skips npm's strict peer-dep resolution
# instead of forking/replacing a working, actively-used library.
legacy-peer-deps=true
